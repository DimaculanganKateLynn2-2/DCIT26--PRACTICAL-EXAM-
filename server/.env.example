# Copy these variables into your EXISTING server/.env. Never commit the real .env.
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@HOST/?retryWrites=true&w=majority
# Required only for the live AI feature:
OPENAI_API_KEY=replace_with_your_private_api_key
OPENAI_MODEL=gpt-6-luna
